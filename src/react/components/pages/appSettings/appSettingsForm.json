{
    "type": "object",
    "properties": {
        "securityTokens": {
            "title": "${strings.appSettings.securityTokens.title}",
            "description": "${strings.appSettings.securityTokens.description}",
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "key"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "title": "${strings.appSettings.securityToken.name.title}"
                    },
                    "key": {
                        "type": "string",
                        "title": "${strings.appSettings.securityToken.key.title}"
                    }
                }
            }
        },
        "tagHotkeys": {
            "title": "快捷键",
            "description": "第 N 行对应第 N 个标签；空行表示不设置。默认：1,2,3,4,5,6,7,8,9,0。不可使用系统占用键：V,R,P,Q,W,S,A,D,E,方向键,Cmd/Ctrl+W/D/C/X/V/S/E/Delete/Backspace。",
            "type": "array",
            "items": {
                "type": "string",
                "title": "标签快捷键"
            }
        }
    }
}
